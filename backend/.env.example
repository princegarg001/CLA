# Copy this file to .env and fill in what you have.
# Every integration degrades gracefully: no key = realistic sample data, key present = live calls.

PORT=8080
BASE_URL=http://localhost:8080
NODE_ENV=development

# API key required to call this backend from the Flutter app (send as X-API-Key header).
# Leave blank while developing locally to skip the check.
CLA_API_KEY=

# Cron automation — set to true to run the scheduled jobs (lead scoring, RSS/job fetch, briefs, reports)
CRON_ENABLED=false

# ---- Database -------------------------------------------------------------
# Supabase (recommended). Leave blank to fall back to the local JSON DB at data/db.json.
# SUPABASE_KEY must be the "service_role" key (Project Settings -> API), NOT the
# anon/public key — supabase_schema.sql's RLS policies only allow service_role,
# since this backend is a trusted server, not a browser client. Never expose the
# service_role key to the Flutter app or any client-side code.
SUPABASE_URL=
SUPABASE_KEY=

# ---- AI ---------------------------------------------------------------------
# Defaults to Groq's free, OpenAI-compatible API (get a key at console.groq.com/keys).
# To use real OpenAI instead: set OPENAI_BASE_URL=https://api.openai.com/v1,
# OPENAI_MODEL=gpt-4o-mini (or similar), and an sk-... key here.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.groq.com/openai/v1
OPENAI_MODEL=openai/gpt-oss-120b
OPENAI_MAX_TOKENS=2048

# ---- Apollo.io ----------------------------------------------------------------
APOLLO_API_KEY=
APOLLO_BASE_URL=https://api.apollo.io/api/v1
# Which Apollo sequence a stale (48h+, no reply) score-8+ Gumroad lead gets
# auto-queued into (Workflow 4 / cron/gumroadFollowUp.js). Leave blank to skip
# the live Apollo call — the lead still gets marked contacted and keeps its
# AI-drafted outreach message ready for you to send manually.
APOLLO_DEFAULT_SEQUENCE_ID=

# ---- Umami (analytics) --------------------------------------------------------
UMAMI_TOKEN=
UMAMI_SITE_ID=
UMAMI_BASE_URL=https://analytics.umami.is/api

# ---- Sentry (error monitoring) -------------------------------------------------
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# ---- Twitter / X ------------------------------------------------------------
# TWITTER_TIER controls which features are attempted: free (post only) | basic (+DMs/analytics) | pro (full)
TWITTER_TIER=free
TWITTER_BEARER_TOKEN=
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_SECRET=

# ---- TrustMRR -----------------------------------------------------------------
TRUSTMRR_API_KEY=
TRUSTMRR_BASE_URL=

# ---- Gumroad --------------------------------------------------------------------
GUMROAD_ACCESS_TOKEN=

# ---- AgentScope -----------------------------------------------------------------
AGENTSCOPE_API_URL=
AGENTSCOPE_API_KEY=

# ---- Verdent.ai -----------------------------------------------------------------
VERDENT_API_KEY=

# ---- HeadAI ---------------------------------------------------------------------
HEADAI_API_KEY=

# ---- WebRobots ------------------------------------------------------------------
WEBROBOTS_API_KEY=

# ---- Gro.app (workflow webhooks) -------------------------------------------------
GRO_WEBHOOK_SECRET=

# ---- RSS-based sources ------------------------------------------------------------
BETALIST_RSS_URL=https://betalist.com/feed
STARTUPSRIP_RSS=https://startups.rip/feed

# ---- Email-parsed sources (forward job emails to your inbound webhook) ----------------
SOLIDGIGS_INBOUND_EMAIL=
CONTRA_INBOUND_EMAIL=

# ---- FoundersDB (no public API — manual import / scrape) ---------------------------
FOUNDERSDB_API_KEY=

# ---- Paperclip (TBD) -----------------------------------------------------------------
PAPERCLIP_API_KEY=

# ---- Outbound email (for alerts / notifications) --------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
ALERT_EMAIL_TO=

# ---- Social publishing / Automation Engine (LinkedIn + Instagram) ---------------------
# LinkedIn: developer.linkedin.com/apps -> add the self-serve "Share on LinkedIn"
# product (no partner approval needed for posting to your own profile).
# Redirect URI must exactly match what's registered on the LinkedIn app.
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=https://cla-v2-backend.onrender.com/api/oauth/linkedin/callback

# Instagram (via Meta): developers.facebook.com -> create an app -> add the
# Instagram product. For single-account use, add yourself as an Instagram
# Tester (Meta dashboard -> Roles) instead of going through App Review.
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=https://cla-v2-backend.onrender.com/api/oauth/instagram/callback

# Twitter/X posting (in addition to TWITTER_BEARER_TOKEN above, which is
# read-only). Posting needs OAuth 1.0a user-context credentials from a
# "Read and Write" app at developer.twitter.com -> your app -> Keys and Tokens:
# API Key/Secret ("Consumer Keys") + Access Token/Secret (generated for YOUR
# account under that app, with read+write permission).
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_SECRET=

# ---- Reddit (free: OAuth2 "script" app, 100 requests/minute) --------------------------
# reddit.com/prefs/apps -> create app -> type "script". client_id is the string
# under the app name; client_secret is the "secret" field. Username/password are
# your own Reddit login (script apps authenticate as your account directly).
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USERNAME=
REDDIT_PASSWORD=
REDDIT_USER_AGENT=CLA:v2:1.0 (by /u/your_username)
REDDIT_MONITORED_SUBS=SaaS,startups,webdev,node,django,freelance,forhire,fintech,devops,microservices
REDDIT_KEYWORDS=backend,api,microservices,automation,python,node,devops,fintech

# ---- Content Calendar --------------------------------------------------------------------
# Fallback timezone for a calendar entry when the client doesn't send one.
DEFAULT_TIMEZONE=America/New_York

# ---- Upwork monitoring (free — no official job-feed API exists) -----------------------
# Upwork itself has no public API for browsing/alerting on jobs and bans auto-apply.
# Point a third-party watcher's webhook (e.g. Vollna's Zapier/webhook integration) at
# POST {BASE_URL}/api/webhooks/upwork?secret=<this value>, or forward job emails to
# POST /api/webhooks/email?source=upwork, or paste jobs manually in the app.
UPWORK_WEBHOOK_SECRET=
UPWORK_SKILLS=Python,Node.js,Backend,DevOps,Microservices,API,Automation
UPWORK_MIN_BUDGET=500

# ---- Push notifications (Firebase Cloud Messaging) -------------------------------------
# console.firebase.google.com -> create project -> Project Settings -> Service
# Accounts -> Generate new private key. Paste the ENTIRE downloaded JSON file as
# one line here (Render has no file upload). Sensitive — handle like the
# Supabase service_role key, never commit it, never send it to the Flutter app.
FIREBASE_SERVICE_ACCOUNT_JSON=
