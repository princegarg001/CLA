# Fill these in and copy to .env
PORT=8080
BASE_URL=http://localhost:8080

# Supabase (optional). If left blank, a local JSON DB is used.
SUPABASE_URL=
SUPABASE_KEY=

# Apollo
APOLLO_API_KEY=
APOLLO_BASE_URL=

# Umami
UMAMI_TOKEN=
UMAMI_SITE_ID=

# Sentry
SENTRY_DSN=
SENTRY_AUTH_TOKEN=

# Twitter/X
TWITTER_BEARER_TOKEN=

# TrustMRR
TRUSTMRR_API_KEY=
TRUSTMRR_BASE_URL=

# Gumroad (OAuth)
GUMROAD_CLIENT_ID=
GUMROAD_CLIENT_SECRET=
GUMROAD_REDIRECT_URI=

# BetaList
BETALIST_RSS_URL=

# SolidGigs / Contra (email parsing)
SOLIDGIGS_INBOUND_EMAIL=
CONTRA_INBOUND_EMAIL=

# AgentScope
AGENTSCOPE_API_URL=
AGENTSCOPE_API_KEY=

# Verdent.ai
VERDENT_API_KEY=

# Gro.app webhook secret
GRO_WEBHOOK_SECRET=

# HeadAI
HEADAI_API_KEY=

# WebRobots
WEBROBOTS_API_KEY=

# Startups.rip
STARTUPSRIP_RSS=

# FoundersDB (if available)
FOUNDERSDB_API_KEY=

# Paperclip (TBD)
PAPERCLIP_API_KEY=
